{
  "name": "onlymuse",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run helper && bun --hot src/main.tsx",
    "helper": "swift build -c release --package-path helper && codesign --force --sign \"onlymuse local\" --identifier dev.mwyndham.onlymuse.helper helper/.build/release/onlymuse-helper",
    "lint": "eslint . && node scripts/check-words.mjs && node scripts/check-structure.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write",
    "start": "bun run helper && NODE_ENV=production bun src/main.tsx",
    "bench": "bun scripts/bench.ts"
  },
  "dependencies": {
    "@gpuix/native": "0.10.0",
    "@gpuix/react": "0.10.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}

diff --git a/crates/gpui_macos/src/display_link.rs b/crates/gpui_macos/src/display_link.rs
index 5387cb6..1ce4219 100644
--- a/crates/gpui_macos/src/display_link.rs
+++ b/crates/gpui_macos/src/display_link.rs
@@ -257,6 +257,21 @@ impl WindowFrameSource {
 
     pub fn start(&mut self, display_id: CGDirectDisplayID) -> Result<()> {
         self.stop();
+        // onlymuse patch: with GPUI_FRAMES_WHEN_COVERED=1 and no display link, a thread asks for a
+        // frame at 120 Hz, as a visible window's display would. It serves measurement only.
+        if std::env::var_os("GPUI_FRAMES_WHEN_COVERED").is_some_and(|value| value == "1") {
+            if let Err(error) = unsafe {
+                sys::DisplayLink::new(display_id, display_link_output_callback, std::ptr::null_mut())
+            } {
+                log::warn!("{error}; asking for frames at 120 Hz from a thread");
+                let frame_requests = self.frame_requests.clone();
+                std::thread::spawn(move || loop {
+                    std::thread::sleep(std::time::Duration::from_micros(8333));
+                    frame_requests.merge_data(1);
+                });
+                return Ok(());
+            }
+        }
         let subscriber_id = subscribe(display_id, self.frame_requests.clone())?;
         self.registration = Some((display_id, subscriber_id));
         Ok(())

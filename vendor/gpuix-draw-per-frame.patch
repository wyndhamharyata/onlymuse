+// onlymuse patch: GPUI_FRAMES_WHEN_COVERED=1 keeps the display link running behind other windows,
+// so a measurement of a covered window runs the code a visible window runs.
+fn frames_when_covered() -> bool {
+    static FRAMES_WHEN_COVERED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *FRAMES_WHEN_COVERED
+        .get_or_init(|| std::env::var_os("GPUI_FRAMES_WHEN_COVERED").is_some_and(|value| value == "1"))
+}

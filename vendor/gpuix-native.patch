+// onlymuse patch: the images kept, by how recently they were drawn. Those in the last frame drawn are
+// never unloaded, so a page with more covers than this keeps them all while they show.
+const RECENT_IMAGE_COUNT: usize = 80;
+const RECENT_IMAGE_IDLE: std::time::Duration = std::time::Duration::from_secs(1);
+
+thread_local! {
+    static RECENT_IMAGES: std::cell::RefCell<Option<gpui::Entity<gpui::RecentImageCache>>> =
+        const { std::cell::RefCell::new(None) };
+}
+
+fn recent_images(cx: &mut gpui::App) -> gpui::Entity<gpui::RecentImageCache> {
+    if let Some(cache) = RECENT_IMAGES.with(|cell| cell.borrow().clone()) {
+        return cache;
+    }
+    let cache = gpui::RecentImageCache::new(RECENT_IMAGE_COUNT, RECENT_IMAGE_IDLE, cx);
+    RECENT_IMAGES.with(|cell| *cell.borrow_mut() = Some(cache.clone()));
+    cache
+}
